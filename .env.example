# Copy to .env. Only the cloud key is needed to get started; provider and model
# are chosen in the UI afterwards and written back to this file.

# --- Cloud provider (any OpenAI-compatible endpoint with json_schema support) ---
# Free Gemini key: https://aistudio.google.com/apikey
CLOUD_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CLOUD_API_KEY=

# --- Active provider (set by the UI; cloud / llamacpp / mlx) ---
PROVIDER=cloud
PROVIDER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
PROVIDER_API_KEY=
DEFAULT_MODEL=gemini-3.1-flash-lite

# --- Local models (optional) ---
# llama-server binary of llama.cpp (on PATH or absolute path)
# LLAMACPP_SERVER=llama-server
# mlx_vlm.server of the fine-tuning repo's virtualenv, and its folder of LoRA adapters
# MLX_SERVER=/path/to/.venv/bin/mlx_vlm.server
# MLX_ADAPTERS_DIR=/path/to/models
# MLX_ADAPTER=

# --- Behaviour (defaults shown) ---
# GRAPHICS_ENABLED=true
# MAX_REQUESTS_PER_MINUTE=15
# MAX_REQUESTS_PER_RUN=200
# ANKI_SERVER=http://127.0.0.1:8765
